---
import "../styles/global.css";
import "../styles/career-dashboard.css";

interface Props {
  title?: string;
}

const { title = "Career Platform | JIANTAO.dev" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon-js.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
