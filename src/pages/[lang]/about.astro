---
import BaseLayout from "../../layouts/BaseLayout.astro";

import {
  locales,
  getTranslations,
  type Locale,
} from "../../i18n";

import type {
  AboutTranslation,
  CommonTranslation,
} from "../../i18n/types";

export function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Locale;

const about =
  getTranslations<AboutTranslation>(
    lang,
    "about",
  );

const common =
  getTranslations<CommonTranslation>(
    lang,
    "common",
  );
---

<BaseLayout
  lang={lang}
>
  <!-- Story -->
  <section class="section bg-app">
    <div class="container grid gap-12 lg:gap-16 ">

        <h2 class="text-title text-text text-center">
          {about.story.title}
        </h2>

        <div class="space-y-5">
          {about.story.paragraphs.map((paragraph) => (
            <p class="text-large text-text-muted">
              {paragraph}
            </p>
          ))}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section bg-surface-muted">
    <div class="container">
      <div class="section-head">
        <h2 class="text-title mt-3 text-text">
          {about.skills.title}
        </h2>

        <p class="text-large mt-4 text-text-muted">
          {about.skills.description}
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {about.skills.items.map((group) => (
          <article class="card p-6">
            <h3 class="text-heading text-text">
              {group.title}
            </h3>

            <div class="mt-5 flex flex-wrap gap-2">

            {group.staritem?.map((item) => (
              <span class="tag tag-star">
                <span aria-hidden="true">
                  ★
                </span>
                {item}
              </span>
            ))}

            {group.items.map((item) => (
              <span class="tag">
                {item}
              </span>
            ))}

          </div>
          </article>
        ))}
      </div>
    </div>
  </section>

    <!-- Education -->
  <section class="section bg-app">
    <div class="container">
      <div class="section-head">
        <h2 class="text-title mt-3 text-text">
          {about.education.title}
        </h2>

        <p class="text-large mt-4 text-text-muted">
          {about.education.description}
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        {about.education.items.map((item) => (
          <article class="card p-6">
            <div class="flex flex-col gap-2">
              <p class="text-sm font-semibold text-brand">
                {item.period}
              </p>

              <h3 class="text-heading text-text">
                {item.degree}
              </h3>

              <p class="text-base font-medium text-text-muted">
                {item.school}
              </p>

              {item.description && (
                <p class="mt-3 leading-7 text-text-muted">
                  {item.description}
                </p>
              )}

              {item.thesis && (
                <p class="mt-3 text-sm text-text-muted">
                  <span class="font-semibold text-text">
                    Thesis:
                  </span>{" "}

                  {item.thesisUrl ? (
                    <a
                      href={item.thesisUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-brand hover:underline"
                    >
                      {item.thesis}
                      <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    item.thesis
                  )}
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>