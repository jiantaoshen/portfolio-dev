---
import BaseLayout from "../../../layouts/BaseLayout.astro";

import {
  getCollection,
  render,
} from "astro:content";

import {
  getTranslations,
  type Locale,
} from "../../../i18n";

import type {
  ProjectTranslation,
  CommonTranslation,
} from "../../../i18n/types";

export async function getStaticPaths() {
  const projects =
    await getCollection(
      "projects",
      ({ data }) => !data.draft,
    );

  return projects.map((project) => {
    const [lang, ...slugParts] =
      project.id.split("/");

    return {
      params: {
        lang,
        slug:
          slugParts.join("/") ||
          undefined,
      },

      props: {
        project,
      },
    };
  });
}

const lang =
  Astro.params.lang as Locale;

const { project } =
  Astro.props;

const projectTranslation =
  getTranslations<ProjectTranslation>(
    lang,
    "project",
  );

const common =
  getTranslations<CommonTranslation>(
    lang,
    "common",
  );

const detail =
  projectTranslation.detail;

const { Content, headings } =
  await render(project);
---

<BaseLayout
  lang={lang}
  title={`${project.data.title} | JIANTAO.dev`}
>
  <!-- Hero -->
  <section class="bg-dark pb-16 pt-32 text-white">
    <div class="container">
      <a
        href={`/${lang}/projects/`}
        class="mb-8 inline-flex items-center gap-2 text-sm text-text-dark-muted transition hover:text-white"
      >
        ← {detail.back}
      </a>

      <div class="flex flex-wrap items-center gap-3">
        <span class="tag-dark">
          {project.data.status}
        </span>
      </div>

        <h1 class="text-display mt-5 max-w-4xl text-white">
          {project.data.title}
        </h1>

      <p class="text-large mt-6 mb-6 max-w-3xl text-text-dark">
        {project.data.description}
      </p>

      <!-- Technologies -->
      {
        project.data.technologies.length > 0 && (
          <div>
            <p class="text-label text-text-subtle">
              {detail.technologies}
            </p>

            <div class="mt-4 flex flex-wrap gap-2">
              {
                project.data.technologies.map(
                  (technology) => (
                    <span class="tag-dark">
                      {technology}
                    </span>
                  ),
                )
              }
            </div>
          </div>
        )
      }

      {
        project.data.links && (
          <div class="mt-8 flex flex-wrap gap-3">
            {
              project.data.links.live && (
                <a
                  href={project.data.links.live}
                  target="_blank"
                  rel="noreferrer"
                  class="btn btn-primary"
                >
                  {common.buttons.liveDemo}
                </a>
              )
            }

            {
              project.data.links.github && (
                <a
                  href={project.data.links.github}
                  target="_blank"
                  rel="noreferrer"
                  class="btn btn-secondary"
                >
                  {common.buttons.github}
                </a>
              )
            }
          </div>
        )
      }
    </div>
  </section>

  <!-- Content -->
  <section class="section bg-app">
    <div
      class="container grid gap-12 lg:grid-cols-[minmax(0,1fr)_280px]"
    >
      <article class="min-w-0">
        <div class="article-content">
          <Content />
        </div>
      </article>

      <aside>
        <div class="sticky top-28 space-y-8">
          <!-- Table of contents -->
          {
            headings.length > 0 && (
              <div>
                <p class="text-label text-text-subtle">
                  Contents
                </p>

                <nav class="mt-4 flex flex-col gap-3">
                  {
                    headings
                      .filter(
                        (heading) =>
                          heading.depth === 2 ||
                          heading.depth === 3,
                      )
                      .map((heading) => (
                        <a
                          href={`#${heading.slug}`}
                          class:list={[
                            "text-sm text-text-muted transition hover:text-brand",
                            heading.depth === 3 &&
                              "pl-4 text-xs",
                          ]}
                        >
                          {heading.text}
                        </a>
                      ))
                  }
                </nav>
              </div>
            )
          }
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>