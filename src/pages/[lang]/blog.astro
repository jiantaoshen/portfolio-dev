---
import BlogListingPage from "../../components/BlogListingPage.astro";

import { getCollection } from "astro:content";

import {
  locales,
  getTranslations,
  type Locale,
} from "../../i18n";

import type {
  BlogTranslation,
  CommonTranslation,
} from "../../i18n/types";

export function getStaticPaths() {
  return locales.map((lang) => ({
    params: {
      lang,
    },
  }));
}

const PAGE_SIZE = 6;

const lang =
  Astro.params.lang as Locale;

const blog =
  getTranslations<BlogTranslation>(
    lang,
    "blog",
  );

const common =
  getTranslations<CommonTranslation>(
    lang,
    "common",
  );

const allPosts = (
  await getCollection(
    "blog",
    ({ data }) =>
      !data.draft &&
      data.lang === lang,
  )
).sort(
  (a, b) =>
    b.data.date.getTime() -
    a.data.date.getTime(),
);

const totalPages = Math.max(
  1,
  Math.ceil(
    allPosts.length / PAGE_SIZE,
  ),
);

const posts =
  allPosts.slice(
    0,
    PAGE_SIZE,
  );
---

<BlogListingPage
  lang={lang}
  blog={blog}
  common={common}
  posts={posts}
  currentPage={1}
  totalPages={totalPages}
/>