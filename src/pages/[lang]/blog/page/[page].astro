---
import BlogListingPage from "../../../../components/BlogListingPage.astro";

import { getCollection } from "astro:content";

import {
  locales,
  getTranslations,
  type Locale,
} from "../../../../i18n";

import type {
  BlogTranslation,
  CommonTranslation,
} from "../../../../i18n/types";

const PAGE_SIZE = 6;

export async function getStaticPaths() {
  const PAGE_SIZE = 6;
  
  const allPosts =
    await getCollection(
      "blog",
      ({ data }) =>
        !data.draft,
    );

  return locales.flatMap(
    (lang) => {
      const count =
        allPosts.filter(
          (post) =>
            post.data.lang === lang,
        ).length;

      const totalPages =
        Math.ceil(
          count / PAGE_SIZE,
        );

      // Page 1 already exists at /blog/
      // Only generate pages 2+
      return Array.from(
        {
          length: Math.max(
            0,
            totalPages - 1,
          ),
        },
        (_, index) => ({
          params: {
            lang,
            page: String(
              index + 2,
            ),
          },
        }),
      );
    },
  );
}

const lang =
  Astro.params.lang as Locale;

const currentPage =
  Number(
    Astro.params.page,
  );

const blog =
  getTranslations<BlogTranslation>(
    lang,
    "blog",
  );

const common =
  getTranslations<CommonTranslation>(
    lang,
    "common",
  );

const allPosts = (
  await getCollection(
    "blog",
    ({ data }) =>
      !data.draft &&
      data.lang === lang,
  )
).sort(
  (a, b) =>
    b.data.date.getTime() -
    a.data.date.getTime(),
);

const totalPages =
  Math.ceil(
    allPosts.length /
      PAGE_SIZE,
  );

const start =
  (currentPage - 1) *
  PAGE_SIZE;

const posts =
  allPosts.slice(
    start,
    start + PAGE_SIZE,
  );
---

<BlogListingPage
  lang={lang}
  blog={blog}
  common={common}
  posts={posts}
  currentPage={currentPage}
  totalPages={totalPages}
/>