---
import BaseLayout from "../../layouts/BaseLayout.astro";

import Hero from "../../components/Hero.astro";
import FeaturedProjects from "../../components/FeaturedProjects.astro";
import TechnicalNotes from "../../components/TechnicalNotes.astro";
import Contact from "../../components/Contact.astro";


import {
  locales,
  getTranslations,
  type Locale,
} from "../../i18n";

export function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Locale;

const home = getTranslations(lang, "home");
const common = getTranslations(lang, "common");
---

<BaseLayout
  lang={lang}
  title="Jiantao Shen | Backend Software Developer"
  description="A backend developer in Eskilstuna"
>
  <Hero
    lang={lang}
    home={home}
    common={common}
  />

  <FeaturedProjects
    lang={lang}
    home={home}
    common={common}
  />

  <TechnicalNotes
    lang={lang}
    home={home}
    common={common}
  />

  <Contact home={home} />
</BaseLayout>