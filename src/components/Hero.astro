---
import type { Locale } from "../i18n";

import type {
  HomeTranslation,
  CommonTranslation,
} from "../i18n/types";

interface Props {
  lang: Locale;
  home: HomeTranslation;
  common: CommonTranslation;
}

const {
  lang,
  home,
  common,
} = Astro.props;

const cvFiles: Record<Locale, string> = {
  en: "/cv/Jiantao_Shen_CV_EN.pdf",
  sv: "/cv/Jiantao_Shen_CV_SV.pdf",
  zh: "/cv/Jiantao_Shen_CV_ZH.pdf",
};

const cvFile = cvFiles[lang];
---

<section class="hero">
  <div
    class="container grid min-h-screen items-center gap-14 pb-20 pt-32 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20 lg:pb-24 lg:pt-28"
  >
    <div class="max-w-2xl">
      <div class="status mb-6">
        <span class="status-dot"></span>
        {home.hero.availability}
      </div>

      <p class="text-label text-brand-muted">
        {home.hero.eyebrow}
      </p>

      <h1 class="text-display mt-4 max-w-3xl text-white">
        {home.hero.titleBefore}
        {" "}
        <span class="text-brand-muted">
          {home.hero.titleHighlight}
        </span>
        {" "}
        {home.hero.titleAfter}
      </h1>

      <p class="text-large mt-7 max-w-xl text-text-dark">
        {home.hero.description}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#contact" class="btn btn-primary">
          {common.buttons.discussProject}
          <span aria-hidden="true">→</span>
        </a>

        <a href="#projects" class="btn btn-secondary">
          {common.buttons.viewWork}
        </a>

        <a
          href={cvFile}
          download
          class="btn btn-secondary"
        >
          {common.buttons.downloadCV}
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <div class="relative">
      <div
        class="absolute -inset-10 -z-10 rounded-full bg-brand/10 blur-3xl"
      ></div>

      <div
        class="rounded-3xl border border-white/10 bg-white/[0.05] p-5 shadow-2xl backdrop-blur-xl sm:p-7"
      >
        <div class="mb-6">
          <p class="text-label text-text-dark-muted">
            {home.hero.architecture.title}
          </p>
        </div>

        <div class="space-y-3">
          <div
            class="rounded-xl border border-white/10 bg-dark-muted/80 p-4"
          >
            <p class="text-label text-text-dark-muted">
              {home.hero.architecture.frontend.label}
            </p>

            <p class="mt-2 font-semibold text-white">
              {home.hero.architecture.frontend.value}
            </p>
          </div>

          <div
            class="flex justify-center text-text-dark-muted"
            aria-hidden="true"
          >
            ↓
          </div>

          <div
            class="rounded-xl border border-brand/30 bg-brand/10 p-4"
          >
            <p class="text-label text-brand-muted">
              {home.hero.architecture.backend.label}
            </p>

            <p class="mt-2 font-semibold text-white">
              {home.hero.architecture.backend.value}
            </p>
          </div>

          <div
            class="flex justify-center text-text-dark-muted"
            aria-hidden="true"
          >
            ↓
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <div
              class="rounded-xl border border-brand/20 bg-brand/[0.08] p-4"
            >
              <p class="text-label text-brand-muted">
                {home.hero.architecture.ai.label}
              </p>

              <p class="mt-2 font-semibold text-white">
                {home.hero.architecture.ai.value}
              </p>
            </div>

            <div
              class="rounded-xl border border-white/10 bg-dark-muted/80 p-4"
            >
              <p class="text-label text-text-dark-muted">
                {home.hero.architecture.data.label}
              </p>

              <p class="mt-2 font-semibold text-white">
                {home.hero.architecture.data.value}
              </p>
            </div>
          </div>

          <div
            class="flex justify-center text-text-dark-muted"
            aria-hidden="true"
          >
            ↓
          </div>

          <div
            class="rounded-xl border border-white/10 bg-dark-muted/80 p-4"
          >
            <p class="text-label text-text-dark-muted">
              {home.hero.architecture.deployment.label}
            </p>

            <p class="mt-2 font-semibold text-white">
              {home.hero.architecture.deployment.value}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>