---
import type {
  HomeTranslation,
} from "../i18n/types";

interface Props {
  home: HomeTranslation;
}

const { home } = Astro.props;
---

<section id="contact" class="section bg-app">
  <div class="container">
    <div class="rounded-3xl bg-dark px-6 py-12 sm:px-10 sm:py-14 lg:px-14 lg:py-16">
      <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
        <div class="max-w-2xl">
          <h1 class="text-title text-white">
            {home.contact.title}
          </h1>

          <p class="text-large max-w-xl text-text-dark">
            {home.contact.description}
          </p>
        </div>

        <div class="flex flex-wrap gap-3 lg:justify-end">
          <a
            href="mailto:jiantaos98@outlook.com"
            class="btn btn-primary"
          >
            {home.contact.email}
            <span aria-hidden="true">→</span>
          </a>

          <a
            href="https://www.linkedin.com/in/jiantaoshen/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </div>
</section>