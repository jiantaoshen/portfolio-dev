---
import { getCollection } from "astro:content";

import type { Locale } from "../i18n";

import type {
  HomeTranslation,
  CommonTranslation,
} from "../i18n/types";

interface Props {
  lang: Locale;
  home: HomeTranslation;
  common: CommonTranslation;
}

const {
  lang,
  home,
  common,
} = Astro.props;

const featuredProjects = (
  await getCollection(
    "projects",
    ({ data }) =>
      !data.draft &&
      data.lang === lang &&
      data.featured,
  )
)
  .sort(
    (a, b) =>
      (a.data.featuredOrder ?? 999) -
      (b.data.featuredOrder ?? 999),
  )
  .slice(0, 2);

function getProjectSlug(id: string) {
  const [, ...parts] = id.split("/");
  return parts.join("/");
}
---

{
  featuredProjects.length > 0 && (
    <section
      id="projects"
      class="section bg-surface-muted"
    >
      <div class="container">

        <!-- Section header -->
        <div class="mb-10 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div class="max-w-2xl">
            <h2 class="text-title mt-3 text-text">
              {home.featuredProjects.title}
            </h2>

            <p class="text-large mt-4 text-text-muted">
              {home.featuredProjects.description}
            </p>
          </div>

          <a
            href={`/${lang}/projects/`}
            class="link-brand shrink-0"
          >
            {home.featuredProjects.viewAll}

            <span aria-hidden="true">
              →
            </span>
          </a>
        </div>

        <!-- Featured projects -->
        <div class="grid gap-6 md:grid-cols-2">
          {
            featuredProjects.map((project) => (
              <article class="card card-hover flex flex-col overflow-hidden p-7 sm:p-8">

                <!-- Category + status -->
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <span class="text-label text-brand">
                    {project.data.category}
                  </span>

                  <span class="tag">
                    {project.data.status}
                  </span>
                </div>

                <!-- Content -->
                <div class="mt-7 flex-1">
                  <h3 class="mt-3 text-2xl font-bold tracking-tight text-text sm:text-3xl">
                    {project.data.title}
                  </h3>

                  <p class="text-body mt-4 max-w-xl text-text-muted">
                    {project.data.description}
                  </p>

                  <!-- Technologies -->
                  {
                    project.data.technologies.length > 0 && (
                      <div class="mt-6 flex flex-wrap gap-2">
                        {
                          project.data.technologies
                            .slice(0, 5)
                            .map((technology) => (
                              <span class="tag">
                                {technology}
                              </span>
                            ))
                        }
                      </div>
                    )
                  }
                </div>

                <!-- Link -->
                <div class="mt-7 border-t border-border pt-5">
                  <a
                    href={`/${lang}/projects/${getProjectSlug(
                      project.id,
                    )}/`}
                    class="link-brand"
                  >
                    {common.buttons.caseStudy}

                    <span aria-hidden="true">
                      →
                    </span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  )
}