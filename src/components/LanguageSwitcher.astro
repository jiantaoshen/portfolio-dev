---
import type { Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const pathname = Astro.url.pathname;

const pathWithoutLanguage = pathname.replace(
  /^\/(en|sv|zh)(?=\/|$)/,
  "",
);

function languageHref(locale: Locale) {
  return `/${locale}${pathWithoutLanguage || "/"}`;
}

const languages: {
  code: Locale;
  label: string;
}[] = [
  { code: "en", label: "EN" },
  { code: "sv", label: "SV" },
  { code: "zh", label: "中文" },
];
---

<div class="flex items-center gap-1">
  {
    languages.map((language) => (
      <a
        href={languageHref(language.code)}
        lang={language.code}
        hreflang={language.code}
        aria-current={
          language.code === lang ? "page" : undefined
        }
        class:list={[
          "rounded-lg px-2.5 py-2 text-sm font-medium transition",
          language.code === lang
            ? "bg-white/10 text-white"
            : "text-text-dark hover:bg-white/5 hover:text-white",
        ]}
      >
        {language.label}
      </a>
    ))
  }
</div>