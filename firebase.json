{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://jiantao-dev.vercel.app/",
        "type": 301
      },
      {
        "source": "/:path*",
        "destination": "https://jiantao-dev.vercel.app/:path",
        "type": 301
      }
    ]
  }
}